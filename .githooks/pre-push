#!/bin/sh
# Runs what CI would run, before anything leaves this machine.
# Enable once per clone:   git config core.hooksPath .githooks
# Skip in an emergency:    git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: clippy" >&2
cargo clippy --quiet --workspace --all-targets -- -D warnings -A dead_code

echo "pre-push: cargo test" >&2
cargo test --quiet --workspace

echo "pre-push: cargo xtask all (C tests, symbols, Miri, TSan)" >&2
cargo xtask all
